	try_files {path} {path}.html /index.html
	import csp_app
	import static
}

{$SCHEME:http}://vert.{$DOMAIN:localhost} {
	root * /srv/vert
	# SvelteKit static export
	try_files {path} {path}.html /index.html
	import csp_app
	import static
}
