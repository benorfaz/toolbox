# Copy to .env on your VPS. Without a .env file, everything defaults to
# plain HTTP on localhost — which is what you want for local OrbStack use.

# Apex domain. Tools are served on pdf.<DOMAIN>, chef.<DOMAIN>, draw.<DOMAIN>.
DOMAIN=tools.example.com

# https enables automatic Let's Encrypt certificates (needs ports 80+443
# reachable and DNS pointing at this host).
SCHEME=https

# Host ports (change if something else already binds 80/443).
HTTP_PORT=80
HTTPS_PORT=443
